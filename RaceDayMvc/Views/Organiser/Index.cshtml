@{
   ViewData["Title"] = "Organiser Dashboard";
}
<div class="container mt-4">
<div class="d-flex justify-content-between align-items-center mb-4">
<h1>Organiser Dashboard</h1>
<a asp-action="CreateEvent" class="btn btn-primary">Create New Event</a>
</div>
<div class="card shadow-sm">
<div class="card-body">
<h4 class="card-title">Your Events</h4>
<hr />
           @if (Model == null || Model.Count == 0)
           {
<p class="text-muted">You haven't created any events yet.</p>
           }
           else
           {
<table class="table table-hover">
<thead class="table-dark">
<tr>
<th>Event Name</th>
<th>Date</th>
<th>Location</th>
<th>Type</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
                       @foreach (var ev in Model)
                       {
<tr>
<td>@ev.GetProperty("eventName").GetString()</td>
<td>@ev.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td>
<td>@ev.GetProperty("city").GetString()</td>
<td><span class="badge bg-info text-dark">@ev.GetProperty("eventType").GetString()</span></td>
<td>
<button class="btn btn-sm btn-outline-secondary">Edit</button>
<button class="btn btn-sm btn-outline-danger">Delete</button>
</td>
</tr>
                       }
</tbody>
</table>
           }
</div>
</div>
</div>