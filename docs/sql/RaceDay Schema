-- ============================================
-- 1. Users Table
-- ============================================
CREATE TABLE Users (
   UserID INT AUTO_INCREMENT PRIMARY KEY,
   Email VARCHAR(100) NOT NULL UNIQUE,
   PasswordHash VARCHAR(255) NOT NULL,
   FirstName VARCHAR(50) NOT NULL,
   LastName VARCHAR(50) NOT NULL,
   IDNumber VARCHAR(13) NOT NULL UNIQUE,
   PhoneNumber VARCHAR(15) NULL,
   DateOfBirth DATE NULL,
   Gender VARCHAR(10) NULL CHECK (Gender IN ('Male', 'Female', 'Other')),
   Role VARCHAR(20) NOT NULL CHECK (Role IN ('Organiser', 'Participant')),
   IsActive BOOLEAN NOT NULL DEFAULT TRUE,
   CreatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   UpdatedAt DATETIME NULL
);
-- ============================================
-- 2. Events Table
-- ============================================
CREATE TABLE Events (
   EventID INT AUTO_INCREMENT PRIMARY KEY,
   OrganiserID INT NOT NULL,
   EventName VARCHAR(100) NOT NULL,
   EventDescription TEXT NULL,
   EventType VARCHAR(20) NOT NULL CHECK (EventType IN ('Running', 'Walking', 'Cycling')),
   EventDate DATE NOT NULL,
   RegistrationStartDate DATE NULL,
   RegistrationEndDate DATE NULL,
   MaxParticipants INT NULL,
   EntryFee DECIMAL(10,2) NULL DEFAULT 0.00,
   Location VARCHAR(200) NULL,
   City VARCHAR(50) NULL,
   Province VARCHAR(50) NULL,
   RouteDetails TEXT NULL,
   IsActive BOOLEAN NOT NULL DEFAULT TRUE,
   CreatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   UpdatedAt DATETIME NULL,
   FOREIGN KEY (OrganiserID) REFERENCES Users(UserID),
   CHECK (EventDate >= RegistrationStartDate)
);
-- ============================================
-- 3. Categories Table
-- ============================================
CREATE TABLE Categories (
   CategoryID INT AUTO_INCREMENT PRIMARY KEY,
   EventID INT NOT NULL,
   CategoryName VARCHAR(50) NOT NULL,
   Distance DECIMAL(6,2) NOT NULL,
   AgeGroup VARCHAR(20) NULL,
   GenderRestriction VARCHAR(10) NULL CHECK (GenderRestriction IN ('Male', 'Female', 'Mixed')),
   EntryFee DECIMAL(10,2) NULL DEFAULT 0.00,
   MaxParticipants INT NULL,
   IsActive BOOLEAN NOT NULL DEFAULT TRUE,
   CreatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   FOREIGN KEY (EventID) REFERENCES Events(EventID)
);
-- ============================================
-- 4. EventEnrolments Table
-- ============================================
CREATE TABLE EventEnrolments (
   EnrolmentID INT AUTO_INCREMENT PRIMARY KEY,
   EventID INT NOT NULL,
   ParticipantID INT NOT NULL,
   CategoryID INT NOT NULL,
   EnrolmentDate DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   RegistrationNumber VARCHAR(50) NOT NULL UNIQUE,
   IsPaid BOOLEAN NOT NULL DEFAULT FALSE,
   Status VARCHAR(20) NOT NULL DEFAULT 'Registered'
       CHECK (Status IN ('Registered', 'Confirmed', 'Cancelled', 'DNS')),
   CreatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   UpdatedAt DATETIME NULL,
   FOREIGN KEY (EventID) REFERENCES Events(EventID),
   FOREIGN KEY (ParticipantID) REFERENCES Users(UserID),
   FOREIGN KEY (CategoryID) REFERENCES Categories(CategoryID),
   UNIQUE KEY (EventID, ParticipantID)
);
-- ============================================
-- 5. Results Table
-- ============================================
CREATE TABLE Results (
   ResultID INT AUTO_INCREMENT PRIMARY KEY,
   EnrolmentID INT NOT NULL,
   ParticipantID INT NOT NULL,
   EventID INT NOT NULL,
   CategoryID INT NOT NULL,
   FinishTime TIME NULL,
   Position INT NULL,
   GenderPosition INT NULL,
   AgeGroupPosition INT NULL,
   OverallPosition INT NULL,
   IsDisqualified BOOLEAN NOT NULL DEFAULT FALSE,
   DisqualificationReason VARCHAR(200) NULL,
   CreatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   UpdatedAt DATETIME NULL,
   FOREIGN KEY (EnrolmentID) REFERENCES EventEnrolments(EnrolmentID),
   FOREIGN KEY (ParticipantID) REFERENCES Users(UserID),
   FOREIGN KEY (EventID) REFERENCES Events(EventID),
   FOREIGN KEY (CategoryID) REFERENCES Categories(CategoryID),
   UNIQUE KEY (EnrolmentID)
);
-- ============================================
-- 6. WeatherLogs Table
-- ============================================
CREATE TABLE WeatherLogs (
   WeatherLogID INT AUTO_INCREMENT PRIMARY KEY,
   EventID INT NOT NULL,
   ForecastDate DATE NOT NULL,
   Temperature DECIMAL(4,1) NULL,
   Condition VARCHAR(50) NULL,
   WindSpeed DECIMAL(4,1) NULL,
   WindDirection VARCHAR(20) NULL,
   Humidity DECIMAL(4,1) NULL,
   Precipitation DECIMAL(4,2) NULL,
   CreatedAt DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
   FOREIGN KEY (EventID) REFERENCES Events(EventID)
);
-- ============================================
-- INDEXES
-- ============================================
CREATE INDEX IX_Events_OrganiserID ON Events(OrganiserID);
CREATE INDEX IX_Events_EventDate ON Events(EventDate);
CREATE INDEX IX_Events_City ON Events(City);
CREATE INDEX IX_Categories_EventID ON Categories(EventID);
CREATE INDEX IX_Enrolments_EventID ON EventEnrolments(EventID);
CREATE INDEX IX_Enrolments_ParticipantID ON EventEnrolments(ParticipantID);
CREATE INDEX IX_Enrolments_CategoryID ON EventEnrolments(CategoryID);
CREATE INDEX IX_Results_EventID ON Results(EventID);
CREATE INDEX IX_Results_ParticipantID ON Results(ParticipantID);
CREATE INDEX IX_Results_CategoryID ON Results(CategoryID);
CREATE INDEX IX_WeatherLogs_EventID ON WeatherLogs(EventID);
